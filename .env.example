# Cấu hình gửi Email cho FITNESS x FIT CLUB
# Email nhận thông tin học viên (Mặc định: conghuyentrangfitness@gmail.com)
STUDIO_EMAIL=conghuyentrangfitness@gmail.com

# (Tùy chọn) Cấu hình SMTP Gmail nếu muốn gửi email trực tiếp qua tài khoản Google của bạn:
# Hướng dẫn tạo App Password: Vào Google Account -> Security -> 2-Step Verification -> App passwords -> Tạo tên "Website Fitness" và dán mật khẩu 16 ký tự vào bên dưới:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=conghuyentrangfitness@gmail.com
SMTP_PASS=your-16-character-app-password

# Địa chỉ Website chính thức
NEXT_PUBLIC_SITE_URL=https://conghuyentrangfitness.com
